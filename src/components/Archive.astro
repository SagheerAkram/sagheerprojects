---
// src/components/Archive.astro
import { projects } from '../data/projects.js';
---

<section id="archive" class="relative z-10 py-48 bg-black/20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-32 gap-12 reveal">
        <div class="max-w-xl">
          <h2 class="text-xs font-black tracking-[0.5em] text-accent-ice uppercase mb-10">• PROJECT ARCHIVE</h2>
          <h3 class="text-4xl md:text-8xl font-black text-white tracking-tighter leading-none italic">Digital Relics &<br/>Experiments.</h3>
        </div>
        <p class="text-slate-500 max-w-[200px] text-[10px] font-black uppercase tracking-[0.2em] leading-relaxed mb-4">
            A technical log of built systems and creative explorations.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal" style="transition-delay: 0.2s;">
      {projects.map((project) => (
        <a href={`/projects/${project.slug || ''}/`} class="tilt-card group relative bg-white/[0.02] border border-white/5 p-12 hover:bg-white/[0.04] transition-all duration-700 flex flex-col justify-between aspect-square rounded-[40px]">
          <div>
            <div class="flex justify-between items-start mb-12">
                <span class="text-[9px] font-black text-accent-ice uppercase tracking-[0.2em]">{project.category || 'Project'}</span>
            </div>
            <h4 class="text-3xl font-black text-white italic tracking-tighter mb-6 group-hover:text-accent-ice transition-colors duration-500">
                {project.title}
            </h4>
            <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed font-light mb-8">
                {project.description}
            </p>
          </div>
          
          <div class="flex flex-wrap gap-2 mt-auto">
            {project.tags?.slice(0, 3).map((tag) => (
                <span class="text-[8px] font-bold text-slate-600 border border-white/10 px-3 py-1.5 rounded-full uppercase tracking-widest">
                    {tag}
                </span>
            ))}
          </div>

          <div class="absolute inset-0 border border-accent-ice/20 opacity-0 group-hover:opacity-100 transition-opacity duration-700 rounded-[40px] pointer-events-none"></div>
        </a>
      ))}
    </div>
  </div>
</section>
