---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos } from '../data/photography.js';
import Archive from '../components/Archive.astro';

const previewPhotos = photos.slice(0, 6);
---

<BaseLayout
  title="Sagheer Akram // Student Researcher. AI Experimenter."
  description="Personal creative lab of Sagheer Akram. Exploring the intersection of AI, code, and visual narratives."
>
  <!-- HERO / MISSION CONTROL -->
  <section class="relative min-h-screen flex flex-col justify-center px-6 md:px-16 pt-32 pb-16 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto w-full">
      <div class="flex flex-col items-center text-center">
        <div class="mb-6 reveal">
          <span class="text-[10px] font-black tracking-[0.4em] text-accent-ice uppercase">CREATIVE PORTFOLIO // Sagheer Akram</span>
        </div>

        <div class="mb-12 reveal" style="transition-delay: 0.1s;">
            <h1 class="text-7xl md:text-[12rem] font-black text-white tracking-tight leading-[0.75] mb-4">
              Sagheer<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-ice to-accent-aurora italic text-glow pr-6">Akram</span>
            </h1>
            <div class="h-px w-24 bg-white/10 mx-auto"></div>
        </div>

        <div class="max-w-2xl mx-auto reveal" style="transition-delay: 0.2s;">
            <p class="text-slate-400 text-xl md:text-2xl leading-relaxed mb-12 font-light">
              Designing <span class="text-white font-medium">intelligent systems</span> that feel human. 
              Currently bridging the gap between logic and the natural world.
            </p>
            
            <div class="flex flex-wrap justify-center gap-6">
              <a href="/projects/" class="group relative px-10 py-5 bg-white text-black font-bold uppercase tracking-widest text-[10px] rounded-full transition-all hover:scale-105 active:scale-95">
                Explore The Archive
              </a>
              <a href="#about" class="group px-10 py-5 bg-transparent border border-white/10 text-white font-bold uppercase tracking-widest text-[10px] rounded-full transition-all hover:bg-white/5 hover:border-white/20">
                View Profile
              </a>
            </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT SECTION -->
  <section id="about" class="relative z-10 py-48 border-t border-white/5 bg-black/10">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-32 items-center">
        <div class="reveal">
          <h2 class="text-xs font-black tracking-[0.5em] text-accent-ice uppercase mb-10">• PROFILE</h2>
          <p class="text-4xl md:text-6xl font-black text-white leading-[1] tracking-tighter mb-12">
            Building at the intersection of <span class="text-accent-ice italic">logic</span> and <span class="text-accent-aurora">nature.</span>
          </p>
          <div class="space-y-8 text-slate-400 text-lg md:text-xl leading-relaxed font-light">
            <p>
              I don't just write code—I craft digital environments. My focus is on how Artificial Intelligence can be seamlessly integrated into human workflows to augment creativity rather than replace it.
            </p>
            <p>
              In my downtime, I explore the world through a 70-200mm lens, capturing the quiet geometric patterns of nature that inspire my technical architecture.
            </p>
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4 reveal" style="transition-delay: 0.3s;">
          {[
            { title: 'AI Logic', desc: 'LLM Integration', icon: 'M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07L19.07 4.93', color: 'text-accent-ice' },
            { title: 'Systems', desc: 'Architecture', icon: 'M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z', color: 'text-accent-aurora' },
            { title: 'Visuals', desc: 'Photography', icon: 'M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h18a2 2 0 0 1 2 2z', color: 'text-white' },
            { title: 'Research', desc: 'Analysis', icon: 'M12 2v20M2 12h20', color: 'text-slate-500' }
          ].map((item, i) => (
            <div class={`group p-8 rounded-[32px] bg-white/[0.02] border border-white/5 hover:border-white/20 transition-all duration-700 ${i % 2 !== 0 ? 'mt-12' : ''}`}>
              <div class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center mb-10 group-hover:scale-110 transition-transform duration-500">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={item.color}><path d={item.icon}/></svg>
              </div>
              <span class="text-white font-bold text-xl block mb-1 tracking-tight">{item.title}</span>
              <span class="text-[9px] text-slate-500 font-bold uppercase tracking-[0.2em]">{item.desc}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- THE ARSENAL -->
  <section class="py-48 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between items-end gap-12 mb-24 reveal">
        <div class="max-w-xl">
          <h2 class="text-xs font-black tracking-[0.5em] text-accent-ice uppercase mb-8">• LAB ARSENAL</h2>
          <h3 class="text-4xl md:text-7xl font-black text-white tracking-tighter leading-none italic">Technical Collaboration Stack.</h3>
        </div>
        <p class="text-slate-500 text-sm font-medium uppercase tracking-widest leading-relaxed max-w-[240px]">
          A curated selection of tools used to manifest digital concepts.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 reveal">
        {[
          { name: 'Astro', type: 'Framework' },
          { name: 'Tailwind', type: 'Design' },
          { name: 'Python', type: 'Logic' },
          { name: 'Node.js', type: 'Runtime' },
          { name: 'Three.js', type: 'Visuals' },
          { name: 'OpenAI', type: 'Intelligence' },
          { name: 'GitHub', type: 'Control' },
          { name: 'Vercel', type: 'Deployment' },
        ].map((tech) => (
          <div class="group p-10 rounded-3xl bg-white/[0.01] border border-white/5 hover:border-accent-ice/30 transition-all duration-700 text-center">
            <div class="w-1.5 h-1.5 rounded-full bg-accent-ice mx-auto mb-8 shadow-[0_0_15px_rgba(148,226,213,0.8)] opacity-20 group-hover:opacity-100 transition-opacity"></div>
            <span class="text-white font-bold text-lg block mb-2 tracking-tight">{tech.name}</span>
            <span class="text-[9px] font-black text-slate-600 uppercase tracking-widest">{tech.type}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE ARCHIVE -->
  <Archive />

  <!-- PHOTOGRAPHY TEASER -->
  <section class="relative z-10 py-48 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-24 reveal">
        <h2 class="text-4xl md:text-8xl font-black text-white tracking-tighter italic mb-8">Visual Memories.</h2>
        <p class="text-slate-500 leading-relaxed text-xl font-light max-w-xl mx-auto">
          Documenting the silence found between lines of code.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 reveal">
        {previewPhotos.slice(0, 3).map((photo) => (
          <div class="gallery-item group relative aspect-[4/5] rounded-[40px] overflow-hidden bg-white/5 border border-white/5">
            <img 
              src={photo.src} 
              alt={photo.title} 
              class="w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-1000 scale-105 group-hover:scale-100" 
              loading="lazy" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 flex flex-col justify-end p-10">
                <span class="text-[10px] text-accent-ice font-black uppercase tracking-widest mb-2">{photo.category}</span>
                <h4 class="text-white text-2xl font-bold tracking-tight">{photo.title}</h4>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-20 reveal">
        <a href="/photography/" class="inline-block text-white font-bold tracking-[0.2em] text-xs uppercase border-b border-white/10 pb-2 hover:border-accent-ice transition-all">
            Enter Full Gallery
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
