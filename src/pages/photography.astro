---
// src/pages/photography.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos, categories } from '../data/photography.js';
import { Image } from 'astro:assets';

// Load all images from the photography assets folder
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/photography/*.{jpeg,jpg,png,gif}');

// Pre-match images with their data objects for the Image component
const galleryPhotos = await Promise.all(photos.map(async (photo) => {
  const imagePath = `../assets${photo.src}`;
  if (!images[imagePath]) {
    console.warn(`Image not found: ${imagePath}`);
    // Check if maybe it's without the leading slash in the glob keys
    const altPath = `../assets${photo.src.startsWith('/') ? photo.src : '/' + photo.src}`;
    if (images[altPath]) {
        const imageImport = await images[altPath]();
        return { ...photo, imageImport: imageImport.default };
    }
    return { ...photo, imageImport: null };
  }
  const imageImport = await images[imagePath]();
  return { ...photo, imageImport: imageImport.default };
}));
---

<BaseLayout
  title="Visual Reflections // Sagheer Akram"
  description="A personal archive of light and silence. Photography by Sagheer Akram."
>
  <section class="relative z-10 max-w-7xl mx-auto px-6 pt-48 pb-24">

    <!-- Header -->
    <div class="mb-32 reveal">
      <div class="flex items-center gap-3 mb-8">
        <span class="w-8 h-px bg-accent-ice/30"></span>
        <span class="text-[10px] font-black tracking-[0.4em] text-accent-ice uppercase">VISUAL ARTIFACTS</span>
      </div>
      <h1 class="text-6xl md:text-9xl font-black text-white tracking-tighter leading-[0.8] mb-12">
        Visual<br/><span class="text-accent-ice italic text-glow">Reflections.</span>
      </h1>
      <div class="grid md:grid-cols-2 gap-16 max-w-5xl">
        <p class="text-slate-400 leading-relaxed text-xl font-light">
          The camera serves as a tool for observation. It allows me to deconstruct the world into its fundamental geometries—light, shadow, and silence. These captures are my way of freezing time in a world that moves too fast.
        </p>
        <div class="h-px w-full bg-white/5 md:hidden"></div>
        <p class="text-slate-500 leading-relaxed text-lg italic border-l border-white/10 pl-8">
          "Composition is the architecture of the soul. These frames are my personal records of moments where the world felt briefly perfect."
        </p>
      </div>
    </div>

    <!-- Filter tabs -->
    <div class="flex flex-wrap gap-2 mb-20 reveal" id="filter-tabs" style="transition-delay: 0.2s;">
      {categories.map((cat) => (
        <button
          class={`px-8 py-3 text-[10px] font-black tracking-[0.2em] uppercase border rounded-full transition-all duration-500 ${
            cat === 'All' 
            ? 'bg-white text-black border-white' 
            : 'text-slate-500 border-white/5 hover:border-white/20 hover:text-white'
          }`}
          data-filter={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="gallery">
      {galleryPhotos.map((photo, i) => (
        <div
          class="gallery-item group relative aspect-[4/5] rounded-[32px] overflow-hidden bg-white/[0.02] border border-white/5 cursor-pointer reveal"
          data-category={photo.category}
          data-id={photo.id}
          style={`transition-delay: ${i % 3 * 0.1}s`}
        >
          {photo.imageImport ? (
            <Image
              src={photo.imageImport}
              alt={`${photo.title} - ${photo.category} photography by Sagheer Akram`}
              width={1200}
              height={1500}
              class="w-full h-full object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-1000 scale-110 group-hover:scale-100"
            />
          ) : (
            <img
              src={photo.src}
              alt={photo.title}
              class="w-full h-full object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-1000"
            />
          )}

          <!-- Status Badge -->
          <div class="absolute top-6 right-6 z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
            <span class="px-4 py-2 bg-black/60 backdrop-blur-xl border border-white/10 rounded-full text-[9px] font-black tracking-[0.2em] text-accent-ice uppercase shadow-2xl">
              {photo.category}
            </span>
          </div>

          <div class="absolute inset-x-0 bottom-0 p-10 translate-y-4 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-700 bg-gradient-to-t from-black/90 via-black/40 to-transparent">
            <h3 class="text-white font-bold text-2xl mb-2 tracking-tight">{photo.title}</h3>
            <p class="text-white/50 text-sm leading-relaxed font-light">{photo.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Closing text -->
    <div class="mt-48 text-center border-t border-white/[0.05] pt-32 reveal">
        <p class="text-slate-600 italic text-lg font-light">"Captured during the hours when the rest of the world was asleep."</p>
    </div>

  </section>
</BaseLayout>

<script>
  // Filter logic
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter || 'All';

      // Update active tab styles
      tabs.forEach(t => {
        t.classList.remove('bg-accent-ice', 'text-black', 'border-accent-ice');
        t.classList.add('text-slate-500', 'border-white/10');
      });
      tab.classList.remove('text-slate-500', 'border-white/10');
      tab.classList.add('bg-accent-ice', 'text-black', 'border-accent-ice');

      // Show/hide items
      items.forEach(item => {
        const cat = item.dataset.category || '';
        const show = filter === 'All' || cat === filter;
        
        if (show) {
          item.style.display = 'block';
          setTimeout(() => {
            item.style.opacity = '1';
            item.style.transform = 'translateY(0) scale(1)';
          }, 10);
        } else {
          item.style.opacity = '0';
          item.style.transform = 'translateY(10px) scale(0.98)';
          setTimeout(() => {
            if (item.style.opacity === '0') item.style.display = 'none';
          }, 400);
        }
      });
    });
  });

  // Entrance animation
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    },
    { 
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px' 
    }
  );

  items.forEach((item, i) => {
    item.classList.add('reveal');
    (item as HTMLElement).style.transitionDelay = `${i % 3 * 0.1}s`;
    observer.observe(item);
  });
</script>
