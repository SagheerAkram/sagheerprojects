---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Identity Log // Sagheer Akram"
  description="Student explorer. Photography, Logic, and the silence in between."
>
  <section class="relative z-10 max-w-5xl mx-auto px-6 pt-48 pb-32">

    <!-- Header -->
    <div class="mb-32 reveal">
      <div class="flex items-center gap-3 mb-10">
        <span class="w-12 h-px bg-accent-ice/30"></span>
        <span class="text-[10px] font-black tracking-[0.5em] text-accent-ice uppercase italic">PROFILE // Sagheer Akram</span>
      </div>
      
      <h1 class="text-6xl md:text-[8rem] font-black text-white tracking-tighter leading-[0.8] mb-16">
        Building tools.<br/><span class="text-accent-ice italic text-glow">Capturing life.</span>
      </h1>
      
      <div class="grid md:grid-cols-2 gap-20">
        <p class="text-slate-400 leading-relaxed text-2xl font-light">
          Hey, I'm Sagheer. I'm a student researcher exploring the intersection of software engineering, automated intelligence, and visual storytelling.
        </p>
        <div class="space-y-8 text-slate-500 text-lg leading-relaxed font-light border-l border-white/5 pl-12">
            <p>I build tools that bridge the gap between complex logic and human intuition. My mission is to make the digital world feel a little more natural, one line of code at a time.</p>
            <p>When I'm not in the terminal, I'm likely deconstructing the world through a 70-200mm lens or solving geometric puzzles in chess.</p>
        </div>
      </div>
    </div>

    <!-- The Toolkit -->
    <div class="mb-48 reveal">
      <h2 class="text-xs font-black tracking-[0.5em] text-accent-ice uppercase mb-16 italic">• THE TOOLKIT</h2>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
        {[
          { icon: 'https://raw.githubusercontent.com/devicons/devicon/master/icons/python/python-original.svg', name: 'Python' },
          { icon: 'https://www.vectorlogo.zone/logos/git-scm/git-scm-icon.svg', name: 'Git' },
          { icon: 'https://raw.githubusercontent.com/devicons/devicon/master/icons/visualstudio/visualstudio-plain.svg', name: 'VS Code' },
          { icon: 'https://www.vectorlogo.zone/logos/linux/linux-icon.svg', name: 'Linux' },
          { icon: 'https://raw.githubusercontent.com/devicons/devicon/master/icons/photoshop/photoshop-line.svg', name: 'Photoshop' },
        ].map((skill) => (
          <div class="tech-card group p-10 rounded-[32px] bg-white/[0.02] border border-white/5 flex flex-col items-center justify-center transition-all duration-700 hover:bg-white/[0.05] hover:border-accent-ice/30">
            <img src={skill.icon} alt={skill.name} class="w-14 h-14 mb-8 grayscale group-hover:grayscale-0 transition-all duration-700 scale-90 group-hover:scale-100" />
            <span class="text-[10px] font-black text-slate-500 group-hover:text-white uppercase tracking-widest transition-colors">{skill.name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Metrics -->
    <div class="mb-48 reveal">
      <div class="flex justify-between items-end mb-16">
        <h2 class="text-xs font-black tracking-[0.5em] text-accent-ice uppercase italic">• SKILLS & REACH</h2>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-8">
            <div class="tilt-card glass-card p-6 overflow-hidden">
                <img src="https://github-readme-stats.vercel.app/api?username=SagheerAkram&show_icons=true&theme=tokyonight&hide_border=true&count_private=true&include_all_commits=true" alt="GitHub Stats" class="w-full opacity-90" />
            </div>
        </div>
        <div class="lg:col-span-4">
            <div class="tilt-card glass-card p-6 overflow-hidden h-full flex items-center">
                <img src="https://github-readme-streak-stats.herokuapp.com/?user=SagheerAkram&theme=tokyonight&hide_border=true" alt="GH Streak" class="w-full opacity-90" />
            </div>
        </div>
      </div>
    </div>

    <!-- Passions -->
    <div class="grid md:grid-cols-2 gap-32 mb-48 reveal">
      <div>
        <h3 class="text-3xl font-black text-white italic tracking-tighter mb-10">Algorithmic Chess.</h3>
        <p class="text-slate-400 text-lg leading-relaxed font-light mb-12">
            Chess is more than a game; it's a study in pattern recognition and strategic foresight. I find a profound connection between the branching logic of a chess opening and the recursive structures of clean code.
        </p>
        <div class="flex items-center gap-6">
            <div class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-accent-ice font-bold">♟</div>
            <span class="text-[10px] font-black text-slate-600 uppercase tracking-widest">Mastering the middle-game.</span>
        </div>
      </div>
      <div>
        <h3 class="text-3xl font-black text-white italic tracking-tighter mb-10">Visual Stillness.</h3>
        <p class="text-slate-400 text-lg leading-relaxed font-light mb-12">
            Photography allows me to stop the clock. It's the only time I'm not thinking about systems or efficiency—just light, shadow, and the narrative of a single frame.
        </p>
        <div class="flex items-center gap-6">
            <div class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-accent-aurora font-bold">📸</div>
            <span class="text-[10px] font-black text-slate-600 uppercase tracking-widest">70-200mm perspective.</span>
        </div>
      </div>
    </div>

    <!-- Final Fact Loop -->
    <div class="reveal">
        <div class="flex flex-wrap gap-4 justify-center">
            {[
                'Design Addict',
                'Continuous Learner',
                'Logic Builder',
                'Visual Storyteller',
                'Chess Strategist'
            ].map(fact => (
                <div class="px-10 py-5 rounded-full border border-white/5 bg-white/[0.01] text-slate-500 font-bold text-[10px] uppercase tracking-[0.3em] hover:border-accent-ice hover:text-white transition-all duration-700">
                    {fact}
                </div>
            ))}
        </div>
    </div>

  </section>
</BaseLayout>
